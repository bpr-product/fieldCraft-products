  "scripts": {
    "start": "cross-env NODE_OPTIONS=--max-old-space-size=4096 craco start",
    "build": "cross-env GENERATE_SOURCEMAP=false DISABLE_ESLINT_PLUGIN=true craco build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "react-scripts test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "eject": "react-scripts eject",
    "check:i18n": "node scripts/i18n/check-duplicates.js",
    "test:i18n": "node scripts/i18n/check-duplicates.test.js",
    "prepare": "node scripts/i18n/setup-hooks.js",
    "sonar": "sonar-scanner -Dsonar.host.url=http://127.0.0.1:9000 -Dsonar.token=${SONAR_TOKEN} -Dsonar.projectKey=fieldcraft-web"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "overrides": [
      {
        "files": [
          "src/language-packs/*.json"
        ],
        "parser": "jsonc-eslint-parser",
        "plugins": [
          "jsonc"
        ],
        "rules": {
          "jsonc/no-dupe-keys": "error"
        }
      }
    ]
  },
  "fork-ts-checker": {
    "typescript": {
      "memoryLimit": 4096
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@craco/craco": "^7.1.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^8.20.1",
